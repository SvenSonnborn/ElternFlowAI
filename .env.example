# Supabase client — werte aus Dashboard → Settings → API Keys
# WICHTIG: nur PUBLISHABLE-Key hier (öffentlich, RLS-geschützt, client-safe).
# Der "secret" / legacy "service_role" Key bypassed RLS und darf NIE in den Mobile-Bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase MCP-Server (nur Entwickler-Tooling, NIE im App-Bundle).
# Personal Access Token aus https://supabase.com/dashboard/account/tokens.
# Wird von mise (mise.toml → [env] _.file) in die Shell exportiert und von
# .mcp.json als Authorization-Header expandiert. Ohne ihn bleibt der MCP-Server
# unverbunden. Der Token hat Account-Reichweite — nicht teilen, nicht committen.
SUPABASE_ACCESS_TOKEN=
