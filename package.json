{
  "name": "eltern-flow-ai",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:android",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:ios",
    "web": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "sh scripts/coderabbit-prepush.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "2.110.7",
    "@tanstack/react-query": "5.101.4",
    "date-fns": "4.4.0",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "26.3.6",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.10",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.17",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/bun": "^1.3.14",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.10",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "~30.4.0",
    "jest-expo": "~57.0.2",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-test-renderer": "19.2.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "private": true
}
