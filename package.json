{
  "name": "eltern-flow-ai",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:android",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:ios",
    "web": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "sh scripts/coderabbit-prepush.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5",
    "date-fns": "^4.3.0",
    "expo": "^55",
    "expo-constants": "~55.0.17",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "i18next": "^25",
    "nativewind": "^4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16",
    "react-native": "0.83.6",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/bun": "^1.3.14",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-test-renderer": "19.2.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.4"
  },
  "private": true
}
