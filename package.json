{
  "name": "eltern-flow-ai",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:android",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:ios",
    "web": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:rn": "jest",
    "test:db": "supabase test db && bun test ./supabase/tests/integration/calendar.db.ts ./supabase/tests/integration/tasks.db.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "sh scripts/coderabbit-prepush.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.105.0",
    "date-fns": "4.4.0",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "i18next": "26.3.6",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.12",
    "react-native": "0.88.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.13.0",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.17",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/bun": "1.4.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "private": true
}
