{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    // config:recommended plus Härtung: Actions auf Commit-SHAs, devDependencies
    // exakt gepinnt, drei Tage Mindestalter für npm-Releases (Sicherheitsupdates
    // ausgenommen), wöchentliche Lockfile-Maintenance, Hinweise auf verwaiste
    // Pakete und Config-Migrations-PRs. Ein Migrations-PR kann die Kommentare
    // dieser Datei verlieren (Renovate schreibt JSON5 dabei teils als JSON) —
    // die Änderung von Hand übernehmen, nicht mergen.
    "config:best-practices",
    // Alle Renovate-Commits als `chore(deps): …`. Passend zu CLAUDE.md
    // ("chore = Wartung / Tooling / CI"). Ohne diesen Preset trennt
    // config:recommended nach `fix(deps)` für prod- und `chore(deps)` für
    // devDependencies — zwei Prefixes für dieselbe Art Arbeit.
    ":semanticCommitTypeAll(chore)",
  ],

  timezone: "Europe/Berlin",
  // Ein Schwung pro Woche statt Tröpfeln über sieben Tage.
  schedule: ["before 6am on monday"],

  // Ohne Automerge bleiben PRs offen, bis jemand sie mergt. Allein die Gruppen
  // ergeben an einem Montag rund sechs Kandidaten, dazu Einzel-PRs und offene
  // Migrationen. Was im Fenster am Montag nicht entsteht, wartet eine Woche —
  // deshalb kein Stundenlimit (der Default wäre 2) und Platz für zehn offene PRs.
  prConcurrentLimit: 10,
  prHourlyLimit: 0,

  labels: ["chore", "dependencies"],

  // Renovate installiert für Lockfile-Updates sonst die neueste Bun-Version.
  // Schreibt die ein Lockfile-Format, das die Bun-Version der CI noch nicht
  // liest, scheitert dort `bun install --frozen-lockfile`. Muss deshalb gleich
  // `bun` in mise.toml und `bun-version:` in den Workflows sein — Regel 8 hebt
  // alle Fundstellen gemeinsam.
  constraints: {
    bun: "1.4.4",
  },

  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["chore", "dependencies", "security"],
    // Leerer Schedule = sofort. CVEs warten nicht bis Montag.
    schedule: [],
  },

  // Kein Automerge, nirgends: Jeder PR wird von Hand gemergt. Grüne CI beweist
  // nicht, dass ein Update in der App funktioniert — sie sieht weder Expo- und
  // NativeWind-Kopplungen noch das Laufzeitverhalten auf dem Gerät.
  //
  // ACHTUNG — die Reihenfolge ist Teil der Semantik: spätere Regeln
  // überschreiben frühere für die Eigenschaften, die sie setzen.
  packageRules: [
    {
      // 1a — devDependencies sammeln: ein PR pro Woche statt einer pro Paket.
      description: "devDependencies (minor+patch)",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dev-dependencies",
    },
    {
      // 1b — dasselbe für dependencies. Jeder PR durchläuft native-build.yml
      // (~30 min), Einzel-PRs pro Paket kosten das jedes Mal. Getrennt von 1a,
      // damit ein Bruch in der App nicht im Tooling-Bump untergeht. Steht vor
      // Regel 3: Expo-verwaltete Pakete wandern dort in ihre eigene Gruppe.
      description: "dependencies (minor+patch)",
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dependencies",
    },
    {
      // 2 — Action-Updates sammeln. Majors laufen über Regel 9.
      description: "GitHub Actions (minor/patch/digest)",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "github actions",
    },
    {
      // 3 — Von Expo SDK verwaltet: die Version bestimmt das SDK, nicht
      // npm-latest. `in-range-only` heißt: nur Updates, die die bereits in
      // package.json stehende Range erfüllen, werden übernommen — alles
      // außerhalb wird komplett verworfen, nie vorgeschlagen. Unter Bun
      // bedeutet "übernehmen" hier aber KEINEN eigenen Lockfile-only-PR pro
      // Paket: Renovates bun-Manager liest anders als der npm-Manager keine
      // `lockedVersion` aus der Lockfile (extrahiert nur package.json), daher
      // taucht ein In-Range-Patch wie `~57.0.7` → 57.0.9 hier nicht als
      // Einzel-Update auf — aktuell gehalten wird das ausschließlich über die
      // wöchentliche `lockFileMaintenance` (aus config:best-practices). 58.x
      // (SDK-Major) bleibt für diese Gruppe trotzdem tabu — außer für `expo`
      // selbst, das Regel 4 gleich danach wieder aufweicht (Begründung dort).
      // Exakt gepinnte Pakete wie react-native 0.86.0 bewegen sich damit gar
      // nicht — gewollt, denn genau dort bricht ein eigenmächtiger Bump den
      // Native-Build, den die CI (nur Web-Export) nicht prüft.
      //
      // Steht bewusst NACH Regel 1a/1b: jest-expo, eslint-config-expo und
      // @types/react sind devDeps *und* Expo-verwaltet, expo-* und react-native
      // dependencies. Diese Regel gewinnt, sie landen also in der Expo-Gruppe.
      // Ebenso setzt `in-range-only` hier den `pin` aus config:best-practices
      // (:pinDevDependencies) außer Kraft — die Tilde-Ranges bleiben.
      //
      // `react-test-renderer` stand hier bis 2026-09-08 mit in der Liste und ist
      // mit dem Paket selbst entfallen: React 19 hat es deprecatet, SDK 57 führt
      // es in keinem der beiden Kanäle mehr, und @testing-library/react-native
      // peert seit v14 auf `test-renderer@^1` statt darauf. ADR-015 (Decision 5)
      // hatte den Eintrag ausdrücklich nur bis zu dieser Entscheidung behalten.
      // `test-renderer` kommt bewusst NICHT als Ersatz hier herein — es ist ein
      // RNTL-Peer, kein Expo-verwaltetes Paket, und läuft damit richtigerweise
      // unter Regel 1a.
      //
      // WICHTIG für alle, die diese Liste pflegen: Expo schreibt Versionen über
      // ZWEI Kanäle vor, und beide müssen hier abgedeckt sein.
      //   (a) `node_modules/expo/bundledNativeModules.json` — die Native-Module.
      //       Web: https://api.expo.dev/v2/sdks/<version>/native-modules
      //   (b) `relatedPackages` der Versions-API — die Toolchain drumherum.
      //       Web: https://api.expo.dev/v2/versions/latest
      //       → .data.sdkVersions["57.0.0"].relatedPackages
      // Kanal (b) enthält u. a. `jest`, `@types/jest` und `typescript` — Pakete,
      // die kein Expo-Namensmuster tragen und deshalb ohne ausdrücklichen
      // Eintrag durch alle Regex-Patterns fallen. Genau das ist 2026-08-14
      // passiert (ADR-015): drei Renovate-PRs wollten typescript auf 7, jest auf
      // 30 und async-storage auf 3 heben, alle drei außerhalb dessen, was SDK 57
      // vorschreibt. Wer hier etwas streicht, prüft es vorher gegen beide Kanäle
      // — `bunx expo install --check` ist die schnellste Gegenprobe.
      description: "Expo-SDK-verwaltete Pakete — nur in-range",
      matchPackageNames: [
        "expo",
        "/^expo-/",
        "/^@expo\\//",
        "react",
        "react-dom",
        "@types/react",
        "react-native",
        "/^react-native-/",
        // Deckt `@react-native/`, `@react-native-community/` und
        // `@react-native-async-storage/` in einem Muster ab. Vorher standen hier
        // die ersten beiden Scopes einzeln — `@react-native-async-storage/`
        // passte auf keinen von beiden (nach `native` steht ein `-`, kein `/`),
        // wodurch async-storage komplett ungeregelt lief. Bewusst breit gefasst:
        // Fehltreffer nimmt Regel 5 wieder heraus, so wie bei `/^react-native-/`.
        // `@react-native/jest-preset` fängt das Muster mit — unverändert
        // gegenüber vorher, `/^@react-native\//` traf es ebenfalls, und das ist
        // gewollt: das Paket ist auf `0.86.0` gepinnt und muss exakt der
        // react-native-Version folgen, nicht npm-latest. Keine Regel-5-Ausnahme.
        "/^@react-native[-\\/]/",
        "jest-expo",
        "eslint-config-expo",
        // Toolchain aus Kanal (b) — kein Expo-Namensmuster, daher namentlich.
        "jest",
        "@types/jest",
        "typescript",
      ],
      rangeStrategy: "in-range-only",
      groupName: "expo sdk (in-range)",
    },
    {
      // 4 — Override von Regel 3, nur für `expo` selbst. Der Renovate-
      // Validator verbietet, rangeStrategy und matchUpdateTypes in derselben
      // Regel zu kombinieren (rangeStrategy wird VOR der Update-Type-
      // Bestimmung ausgewertet — Renovate wüsste sonst nicht, wonach es
      // überhaupt suchen soll; siehe Validator-Meldung "packageRules cannot
      // combine both matchUpdateTypes and rangeStrategy"). Deshalb kann
      // Regel 6 (Expo-Major) das rangeStrategy-Verhalten nicht selbst setzen
      // — es muss hier, paketbezogen statt updateType-bezogen, passieren.
      // `in-range-only` (Regel 3) verwirft Out-of-Range-Updates komplett,
      // noch bevor Regel 6 sie zu Gesicht bekommt — die Expo-Major-Regel liefe
      // damit ins Leere. `update-lockfile` verhält sich für In-Range-Updates
      // identisch zu `in-range-only` (unter Bun: kein Einzel-PR, siehe
      // Begründung in Regel 3 — beide verlassen sich für In-Range auf
      // `lockFileMaintenance`), fällt für Out-of-Range-Updates aber auf
      // `replace` zurück und schlägt package.json vor. Das trifft nicht nur
      // 58.x (Major), sondern auch einen Minor wie 57.1.0 gegen die Range
      // `~57.0.7` — beide Fälle fängt Regel 6 ab und sperrt sie hinter
      // dependencyDashboardApproval.
      description: "expo: rangeStrategy-Override, damit Regel 6 Majors und Minors überhaupt sieht",
      matchPackageNames: ["expo"],
      rangeStrategy: "update-lockfile",
    },
    {
      // 5 — Korrigiert Regel 3: deren Regex /^react-native-/ fängt diese beiden
      // mit ein, obwohl Expo sie nicht verwaltet. Zwei benannte Ausnahmen statt
      // einer gepflegten Zwanzig-Pakete-Liste. `groupName: null` nimmt sie auch
      // aus Gruppe 1b — beide laufen als Einzel-PR, sie bewegen sich selten.
      description: "Trotz react-native-Präfix nicht von Expo verwaltet",
      matchPackageNames: ["react-native-calendars", "react-native-url-polyfill"],
      rangeStrategy: "replace",
      groupName: null,
    },
    {
      // 6 — Der SDK-Sprung. Renovate hebt NUR `expo`; expo-sdk-sync.yml zieht
      // react-native, expo-*, react und @types/react per `expo install --fix`
      // nach. dependencyDashboardApproval heißt: kein PR, bis die Checkbox im
      // Dashboard gesetzt wird. Kein eigenes rangeStrategy hier — das liefert
      // bereits Regel 4 (siehe deren Begründung: Validator verbietet die
      // Kombination mit matchUpdateTypes in derselben Regel).
      //
      // matchUpdateTypes enthält neben "major" auch "minor": Regel 4s
      // `update-lockfile` fällt nicht nur für einen SDK-Major (58.x) auf
      // `replace` zurück, sondern für JEDES Out-of-Range-Update — und bei der
      // Tilde-Range `~57.0.7` ist ein Minor-Bump (z. B. 57.1.0) per Definition
      // immer out-of-range. Ohne diese Zeile würde so ein Minor package.json
      // umschreiben, aber OHNE `expo-sdk`-Label und OHNE Dashboard-Freigabe —
      // expo-sdk-sync.yml würde dafür nie feuern, ein halb migrierter Zustand
      // könnte gemergt werden. Diese Regel fängt beide Fälle ab.
      description: "Expo-Major = SDK-Sprung, nur auf Zuruf",
      matchPackageNames: ["expo"],
      matchUpdateTypes: ["major", "minor"],
      groupName: null,
      dependencyDashboardApproval: true,
      labels: ["chore", "dependencies", "expo-sdk"],
      commitMessageTopic: "Expo SDK",
    },
    {
      // 7 — JDK bleibt 17: der Gradle-Wrapper verträgt nur bestimmte
      // JDK-Versionen. Welche und warum, steht im Kommentar in mise.toml.
      description: "JDK-Pin nicht anfassen (Gradle-Wrapper verträgt nicht jedes JDK)",
      matchManagers: ["mise"],
      matchDepNames: ["java"],
      enabled: false,
    },
    {
      // 8 — mise.toml, die Workflow-Dateien und `constraints` oben müssen
      // dieselbe Bun-Version tragen. Alle drei Manager (mise, github-actions
      // über den `bun-version:`-Input von oven-sh/setup-bun, renovate-config)
      // melden sie unter dem depName `bun`; sie landen so in einem PR. Steht
      // nach Regel 2, deren Actions-Gruppe sonst den Workflow-Anteil abzöge.
      description: "Bun-Toolchain (mise.toml + Workflows + constraints gemeinsam)",
      matchDepNames: ["bun"],
      groupName: "bun toolchain",
    },
    {
      // 9 — Majors nur auf Zuruf: kein PR, bis die Checkbox im Dependency
      // Dashboard gesetzt ist. Ein Major ist eine Migration mit eigenem Plan,
      // kein Wochen-Update; ein offener PR, der monatelang liegt, ist Lärm.
      // Sicherheitsupdates greift das nicht — vulnerabilityAlerts setzt
      // dependencyDashboardApproval für sie selbst wieder auf false.
      description: "Majors nur nach Freigabe im Dependency Dashboard",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // 10 — NativeWind v4 baut auf Tailwind 3.4; v4 braucht die Migration aus
      // docs/TODO.md (Tailwind v3 → v4), nicht einen Bump. Grüne CI hilft hier
      // nicht: der Bruch zeigt sich erst im gerenderten Styling.
      description: "tailwindcss bleibt auf v3 (NativeWind v4)",
      matchPackageNames: ["tailwindcss"],
      allowedVersions: "<4",
    },
    {
      // 11 — typescript-eslint als Range, nicht gepinnt. eslint-config-expo
      // bringt @typescript-eslint/eslint-plugin und /parser als eigene
      // Abhängigkeit mit, eslint.config.js lädt das Plugin über beide Wege.
      // Hebt Renovate nur typescript-eslint, lässt Bun die Kopie von
      // eslint-config-expo im Lockfile stehen — zwei Plugin-Versionen unter
      // einem Namen, ESLint bricht mit `Cannot redefine plugin
      // "@typescript-eslint"` ab. Mit Range bewegt es nur die
      // Lockfile-Maintenance, die alle Kopien gemeinsam hebt. Ein Major läuft
      // über Regel 9 und muss eslint-config-expo ohnehin mitnehmen.
      description: "typescript-eslint muss dieselbe Version auflösen wie eslint-config-expo",
      matchPackageNames: ["typescript-eslint"],
      rangeStrategy: "replace",
    },
  ],
}
